{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [".env.locale"],
  "tasks": {
    "start": {
      "dependsOn": ["^start"],
      "cache": false
    },
    "dev": {
      "dependsOn": [],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"]
    },  
    "lint": {
      "outputs": []
    }
  }
}
